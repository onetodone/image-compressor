{
  "name": "@onetodone/image-compressor",
  "version": "0.4.0",
  "description": "Image compression service: upload JPEG or PNG images and download smaller versions.",
  "private": true,
  "type": "module",
  "author": "Anton Holubeu (https://github.com/aholu)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onetodone/image-compressor.git"
  },
  "homepage": "https://github.com/onetodone/image-compressor#readme",
  "bugs": {
    "url": "https://github.com/onetodone/image-compressor/issues"
  },
  "keywords": [
    "image",
    "compression",
    "jpeg",
    "png",
    "sharp",
    "nestjs",
    "nextjs",
    "firebase",
    "cloud-run"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @onetodone/image-compressor-api start",
    "emulators": "firebase emulators:start --config infra/firebase.json --project demo-image-compressor",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\"",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --config infra/firebase.test.json --project demo-image-compressor-test --only auth,firestore 'vitest run --project integration'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.14.0"
}
