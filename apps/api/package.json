{
  "name": "@onetodone/image-compressor-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm --filter @onetodone/image-compressor-shared build && tsc -p tsconfig.build.json && pnpm run \"/^watch:/\"",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:api": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.api.js",
    "watch:worker": "PORT=3002 node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.worker.js",
    "start": "pnpm run \"/^start:/\"",
    "start:api": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.api.js",
    "start:worker": "PORT=3002 node --enable-source-maps --env-file-if-exists=../../.env dist/main.worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@onetodone/image-compressor-shared": "workspace:*",
    "firebase-admin": "^14.5.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
