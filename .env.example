# Runtime
NODE_ENV=development
# API port. Cloud Run injects PORT for each service.
PORT=3001

# Google Cloud / Firebase. A "demo-" project id keeps the emulators offline.
GCP_PROJECT_ID=demo-image-compressor
CORS_ORIGINS=http://localhost:3000

# Firebase emulators (local only)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Outside Google Cloud, skip the metadata server lookup (about 3 s per client) that Google auth
# libraries run to find credentials. Leave unset on Cloud Run.
METADATA_SERVER_DETECTION=none

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=image-compressor-dev

# Cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=image-compressor-dev

# Background jobs: "direct" calls the worker over HTTP, "cloud" uses Cloud Tasks
TASKS_MODE=direct
TASKS_LOCATION=europe-west3
TASKS_QUEUE=image-compressor-jobs
TASKS_SERVICE_ACCOUNT=
TASKS_MAX_ATTEMPTS=5
WORKER_URL=http://localhost:3002

# Logging
SLOW_CALL_THRESHOLD_MS=1000

# Web app (public, embedded in the static export)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-image-compressor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-image-compressor
NEXT_PUBLIC_FIREBASE_APP_ID=
